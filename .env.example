# FacturaLibre — variables de entorno. Copia este fichero a .env y sustituye TODOS los valores "cambia-esto".
# Nunca subas .env al repositorio. Genera contraseñas con, p. ej.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# ─── Entorno ──────────────────────────────────────────────────────────────────
# NODE_ENV no se fija aquí: lo establecen Next.js, Vitest y Docker según el comando.
# development | test | production. Controla, entre otras cosas, el entorno AEAT (Fase 6). En development NUNCA se usa AEAT real.
FACTURALIBRE_ENV=development
APP_BASE_URL=http://localhost:3000

# ─── PostgreSQL: rol administrador / propietario de tablas (solo migraciones) ─────
POSTGRES_USER=facturalibre_owner
POSTGRES_PASSWORD=cambia-esto-owner-min-16-caracteres
POSTGRES_DB=facturalibre
POSTGRES_PORT=5432
DATABASE_URL=postgresql://facturalibre_owner:cambia-esto-owner-min-16-caracteres@localhost:5432/facturalibre

# ─── Roles de ejecución (los crea `pnpm db:migrate`; mínimo 16 caracteres) ──────
APP_DB_PASSWORD=cambia-esto-app-min-16-caracteres
AUTH_DB_PASSWORD=cambia-esto-auth-min-16-caracteres
WORKER_DB_PASSWORD=cambia-esto-worker-min-16-caracteres

# URLs de conexión de cada rol (mismas contraseñas que arriba)
APP_DATABASE_URL=postgresql://facturalibre_app:cambia-esto-app-min-16-caracteres@localhost:5432/facturalibre
AUTH_DATABASE_URL=postgresql://facturalibre_auth:cambia-esto-auth-min-16-caracteres@localhost:5432/facturalibre
WORKER_DATABASE_URL=postgresql://facturalibre_worker:cambia-esto-worker-min-16-caracteres@localhost:5432/facturalibre

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=8081

# ─── Pruebas ─────────────────────────────────────────────────────────────────
# Opcional: servidor PostgreSQL administrador para pruebas de integración (crea una BD nueva por ejecución).
# Si se deja vacío, las pruebas arrancan un PostgreSQL 18 efímero con embedded-postgres.
TEST_DATABASE_URL=

# ─── Previstas para fases posteriores (NO usadas todavía) ──────────────────────
# Fase 2 — autenticación (Better Auth): secreto de firma de sesiones (>= 32 bytes aleatorios)
# AUTH_SECRET=
# Fase 2 — correo (verificación, invitaciones). En desarrollo, servidor SMTP local de pruebas.
# SMTP_URL=
# Fase 6 — clave maestra de cifrado de certificados (KEK). En producción, desde un gestor de secretos, nunca en .env.
# CERTIFICATE_KEK=
