// FacturaLibre — esquema inicial (Fase 1): identidad, multi-tenancy, contribuyentes, auditoría y outbox.
// Documentación: docs/database/data-model.md y docs/database/tenant-constraints.md
//
// Reglas:
//  - Nombres físicos en snake_case (@@map/@map).
//  - Identificadores UUID generados por PostgreSQL 18 (uuidv7()).
//  - Toda tabla de organización lleva tenant_id; toda tabla fiscal llevará además taxpayer_id.
//  - Las relaciones entre entidades de un tenant usan claves foráneas COMPUESTAS (tenant_id, id)
//    para que la base de datos impida asociar filas de tenants distintos.
//  - Restricciones que Prisma no expresa (CHECK, índices parciales, RLS, triggers) viven en SQL
//    dentro de prisma/migrations y están documentadas en docs/tenancy/rls-policies.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enumeraciones
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  DEACTIVATED
}

enum TenantRole {
  OWNER
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Alcance de un miembro sobre los contribuyentes del tenant.
/// ALL_TAXPAYERS: todos (típico de OWNER/ADMIN). ASSIGNED_TAXPAYERS: solo los de taxpayer_memberships.
enum TaxpayerScope {
  ALL_TAXPAYERS
  ASSIGNED_TAXPAYERS
}

enum TaxpayerAccessLevel {
  READ_ONLY
  FULL
}

/// Persona física o jurídica (obligado tributario emisor).
enum TaxpayerPersonType {
  NATURAL_PERSON
  LEGAL_ENTITY
}

enum TaxpayerStatus {
  ACTIVE
  DEACTIVATED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidad global (no pertenece a ningún tenant)
// Las tablas users/sessions/accounts/verifications siguen la forma que espera la
// librería de autenticación elegida (ADR-006, Better Auth). Se revisará en Fase 2.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  /// Siempre en minúsculas (CHECK en SQL).
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  /// Cuenta desactivada por su titular (Fase 7): sin acceso; se conserva la autoría en la auditoría.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile             UserProfile?
  sessions            Session[]
  accounts            Account[]
  tenantMemberships   TenantMembership[]
  invitationsSent     TenantInvitation[] @relation("InvitationInvitedBy")
  invitationsAccepted TenantInvitation[] @relation("InvitationAcceptedBy")

  @@map("users")
}

model UserProfile {
  userId    String   @id @map("user_id") @db.Uuid
  locale    String   @default("es-ES")
  timeZone  String   @default("Europe/Madrid") @map("time_zone")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Token opaco de sesión (la librería de auth almacena su forma firmada/hasheada).
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Hash de contraseña (nunca la contraseña en claro).
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Contadores de rate limiting de la librería de autenticación (persistentes y compartidos entre réplicas).
model RateLimit {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String @unique
  count       Int
  /// Marca de tiempo en milisegundos desde epoch (formato de la librería).
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organización (tenant)
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Identificador en URL. Nunca se usa para autorizar (CHECK de formato en SQL).
  slug          String       @unique
  name          String
  contactEmail  String?      @map("contact_email")
  contactPhone  String?      @map("contact_phone")
  status        TenantStatus @default(ACTIVE)
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings    TenantSettings?
  memberships TenantMembership[]
  invitations TenantInvitation[]
  taxpayers   Taxpayer[]

  @@map("tenants")
}

model TenantSettings {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  locale    String   @default("es-ES")
  timeZone  String   @default("Europe/Madrid") @map("time_zone")
  /// Fase inicial: solo EUR (CHECK en SQL).
  currency  String   @default("EUR") @db.Char(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

model TenantMembership {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  role          TenantRole
  taxpayerScope TaxpayerScope    @default(ASSIGNED_TAXPAYERS) @map("taxpayer_scope")
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  taxpayerMemberships TaxpayerMembership[]

  /// Un usuario tiene como máximo una membresía por tenant.
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model TenantInvitation {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  /// Siempre en minúsculas (CHECK en SQL).
  email            String
  /// Nunca OWNER: la propiedad solo se transfiere (CHECK en SQL).
  role             TenantRole
  taxpayerScope    TaxpayerScope @default(ASSIGNED_TAXPAYERS) @map("taxpayer_scope")
  /// SHA-256 del token enviado por correo. El token en claro no se almacena.
  tokenHash        String        @unique @map("token_hash")
  invitedByUserId  String        @map("invited_by_user_id") @db.Uuid
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?     @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?       @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy  User   @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User?  @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Obligado tributario (emisor fiscal) dentro de un tenant
// ─────────────────────────────────────────────────────────────────────────────

model Taxpayer {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  personType  TaxpayerPersonType @map("person_type")
  /// NIF del obligado tributario (9 caracteres alfanuméricos en mayúsculas; CHECK en SQL).
  /// La validación del dígito de control vive en el dominio (Fase 3).
  nif         String
  /// Nombre y apellidos o razón social.
  legalName   String             @map("legal_name")
  tradeName   String?            @map("trade_name")
  addressLine String?            @map("address_line")
  postalCode  String?            @map("postal_code")
  city        String?
  province    String?
  countryCode String             @default("ES") @map("country_code") @db.Char(2)
  email       String?
  status      TaxpayerStatus     @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  settings       TaxpayerSettings?
  memberships    TaxpayerMembership[]
  customers      Customer[]
  products       Product[]
  invoiceSeries  InvoiceSeries[]
  invoices       Invoice[]
  invoiceLines   InvoiceLine[]
  billingSystem  BillingSystem?
  billingRecords BillingRecord[]
  certificate    TaxpayerCertificate?

  /// Destino de las claves foráneas compuestas (tenant_id, taxpayer_id).
  @@unique([tenantId, id])
  /// El mismo NIF puede existir en tenants distintos (p. ej. empresa y su gestoría): cada uno es
  /// una "facturación" distinta (ver docs/verifactu/hashing-and-chaining.md). Dentro del tenant, único.
  @@unique([tenantId, nif])
  @@map("taxpayers")
}

model TaxpayerSettings {
  taxpayerId              String   @id @map("taxpayer_id") @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  defaultPaymentTermsDays Int?     @map("default_payment_terms_days")
  invoiceFooterNote       String?  @map("invoice_footer_note")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxpayer Taxpayer @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, taxpayerId])
  @@map("taxpayer_settings")
}

model TaxpayerMembership {
  id          String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  taxpayerId  String              @map("taxpayer_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  accessLevel TaxpayerAccessLevel @default(FULL) @map("access_level")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  /// El contribuyente debe pertenecer al MISMO tenant (FK compuesta).
  taxpayer         Taxpayer         @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)
  /// El usuario debe ser miembro del MISMO tenant (FK compuesta). Si pierde la membresía, pierde el acceso.
  tenantMembership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@unique([taxpayerId, userId])
  @@index([tenantId, userId])
  @@map("taxpayer_memberships")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoría (append-only, protegida por trigger y permisos) y Transactional Outbox
// ─────────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?      @map("actor_user_id") @db.Uuid
  tenantId    String?      @map("tenant_id") @db.Uuid
  taxpayerId  String?      @map("taxpayer_id") @db.Uuid
  /// Verbo en notación punto, p. ej. "tenant.switch", "member.role_changed".
  action      String
  entityType  String?      @map("entity_type")
  entityId    String?      @map("entity_id")
  outcome     AuditOutcome
  requestId   String?      @map("request_id")
  /// Contexto técnico mínimo. Nunca contraseñas, tokens, claves ni certificados.
  metadata    Json?

  @@index([tenantId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model OutboxEvent {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  taxpayerId     String?      @map("taxpayer_id") @db.Uuid
  type           String
  payload        Json
  /// Evita encolar dos veces el mismo trabajo lógico.
  idempotencyKey String       @unique @map("idempotency_key")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(10) @map("max_attempts")
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt       DateTime?    @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?      @map("locked_by")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([tenantId])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Facturación (Fase 4). Todo cuelga de un contribuyente: (tenant_id, taxpayer_id) y FKs compuestas
// (taxpayer_id, id) para que una factura no pueda mezclar clientes, series ni líneas de otro.
// Importes en céntimos; cantidades (3 dec.), precios (4 dec.) y porcentajes (2 dec.) como enteros
// escalados. Ver docs/decisions/ADR-007-invoice-calculation.md. Restricciones, RLS e inmutabilidad
// de las facturas emitidas: migración 20261124000400_invoicing.
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceKind {
  STANDARD
  RECTIFYING
}

enum InvoiceStatus {
  DRAFT
  ISSUED
}

model Customer {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  taxpayerId           String   @map("taxpayer_id") @db.Uuid
  /// NIF español (validado en el dominio); null para clientes sin NIF español (⏳ identificadores extranjeros).
  nif                  String?
  legalName            String   @map("legal_name")
  addressLine          String?  @map("address_line")
  postalCode           String?  @map("postal_code")
  city                 String?
  province             String?
  countryCode          String   @default("ES") @map("country_code") @db.Char(2)
  email                String?
  /// Cliente en el régimen especial del recargo de equivalencia.
  equivalenceSurcharge Boolean  @default(false) @map("equivalence_surcharge")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxpayer Taxpayer  @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([taxpayerId, id])
  @@index([taxpayerId, legalName])
  @@map("customers")
}

model Product {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  taxpayerId String   @map("taxpayer_id") @db.Uuid
  name       String
  /// Precio unitario sin IVA en diezmilésimas de euro.
  unitPrice  BigInt   @map("unit_price")
  /// "VAT:2100" | "VAT:1000" | "VAT:400" | "VAT:0" | "EXEMPT" (CHECK en SQL).
  taxKey     String   @map("tax_key")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxpayer Taxpayer @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)

  @@index([taxpayerId, name])
  @@map("products")
}

model InvoiceSeries {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  taxpayerId String      @map("taxpayer_id") @db.Uuid
  /// Prefijo visible del número, p. ej. "F2026" o "R2026" (CHECK de formato en SQL).
  code       String
  /// Las rectificativas van en series propias (RD 1619/2012, art. 6.1.a).
  kind       InvoiceKind
  /// Próximo número; solo avanza al emitir, en la misma transacción (sin huecos).
  nextNumber Int         @default(1) @map("next_number")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  taxpayer Taxpayer  @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([taxpayerId, code])
  @@unique([taxpayerId, id])
  @@map("invoice_series")
}

model Invoice {
  id                   String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  taxpayerId           String        @map("taxpayer_id") @db.Uuid
  seriesId             String        @map("series_id") @db.Uuid
  customerId           String        @map("customer_id") @db.Uuid
  kind                 InvoiceKind
  status               InvoiceStatus @default(DRAFT)
  /// Asignado solo al emitir (CHECK: borrador sin número, emitida con número).
  number               Int?
  issueDate            DateTime?     @map("issue_date") @db.Date
  /// Fecha de la operación si es distinta de la de expedición.
  operationDate        DateTime?     @map("operation_date") @db.Date
  equivalenceSurcharge Boolean       @default(false) @map("equivalence_surcharge")
  /// Retención de IRPF en porcentaje a escala 2 (1500 = 15 %).
  withholdingPercent   Int           @default(0) @map("withholding_percent")
  taxableBase          BigInt        @default(0) @map("taxable_base")
  vatTotal             BigInt        @default(0) @map("vat_total")
  surchargeTotal       BigInt        @default(0) @map("surcharge_total")
  withholdingAmount    BigInt        @default(0) @map("withholding_amount")
  total                BigInt        @default(0)
  /// Datos del emisor y del destinatario tal como eran al emitir (la factura no cambia si cambian después).
  issuerSnapshot       Json?         @map("issuer_snapshot")
  customerSnapshot     Json?         @map("customer_snapshot")
  /// Factura rectificada (FK compuesta (taxpayer_id, rectifies_invoice_id) definida en SQL: Prisma no admite
  /// una relación opcional con una columna obligatoria en la clave).
  rectifiesInvoiceId   String?       @map("rectifies_invoice_id") @db.Uuid
  rectificationReason  String?       @map("rectification_reason")
  /// Clave de la rectificativa (lista L2 de VERI*FACTU): "R1" | "R2" | "R3" | "R4" (CHECK en SQL). ADR-008.
  rectificationCode    String?       @map("rectification_code")
  notes                String?
  createdByUserId      String?       @map("created_by_user_id") @db.Uuid
  issuedByUserId       String?       @map("issued_by_user_id") @db.Uuid
  issuedAt             DateTime?     @map("issued_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxpayer       Taxpayer        @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)
  series         InvoiceSeries   @relation(fields: [taxpayerId, seriesId], references: [taxpayerId, id], onDelete: Restrict)
  customer       Customer        @relation(fields: [taxpayerId, customerId], references: [taxpayerId, id], onDelete: Restrict)
  lines          InvoiceLine[]
  billingRecords BillingRecord[]

  @@unique([taxpayerId, id])
  @@unique([seriesId, number])
  @@index([taxpayerId, status, createdAt])
  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// VERI*FACTU (Fase 5). Una «facturación» (SIF virtual) por contribuyente con UNA cadena de registros de alta
// y anulación (OM HAC/1177/2024, arts. 2 y 7; ADR-004 y ADR-008). Registros inalterables, cadena comprobada
// por la BD al insertar: migración 20261124000500_verifactu.
// ─────────────────────────────────────────────────────────────────────────────

enum BillingRecordKind {
  ALTA
  ANULACION
}

/// Estado de la remisión a la AEAT (Fase 6). Los valores oficiales de la respuesta se guardan aparte.
enum BillingRecordStatus {
  PENDING
  ACCEPTED
  ACCEPTED_WITH_ERRORS
  REJECTED
}

model BillingSystem {
  /// También es el NumeroInstalacion: un UUID nunca se repite para ningún NIF.
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  taxpayerId          String    @map("taxpayer_id") @db.Uuid
  /// Secuencia del último registro de la cadena (0 = aún sin registros). Solo avanza.
  lastSequence        Int       @default(0) @map("last_sequence")
  /// Remisión a la AEAT (Fase 6, OM art. 16): no se envía antes de next_send_at (control de flujo o reintento).
  nextSendAt          DateTime? @map("next_send_at") @db.Timestamptz(6)
  /// TiempoEsperaEnvio devuelto por la AEAT en la última respuesta (60 s al principio).
  waitSeconds         Int       @default(60) @map("wait_seconds")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  /// Desde cuándo una incidencia impide remitir (null = sin incidencia). Mientras dure se avisa (art. 16.4).
  failingSince        DateTime? @map("failing_since") @db.Timestamptz(6)
  lastError           String?   @map("last_error")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxpayer Taxpayer        @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)
  records  BillingRecord[]

  /// Una facturación por contribuyente (y la FK compuesta exige el par como único).
  @@unique([tenantId, taxpayerId])
  @@unique([taxpayerId])
  @@unique([taxpayerId, id])
  @@map("billing_systems")
}

model BillingRecord {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  taxpayerId           String              @map("taxpayer_id") @db.Uuid
  billingSystemId      String              @map("billing_system_id") @db.Uuid
  /// Posición en la cadena: 1, 2, 3… sin huecos.
  sequence             Int
  kind                 BillingRecordKind
  invoiceId            String              @map("invoice_id") @db.Uuid
  /// Identificador de la factura tal como figura en el registro (NIF + serie y número + fecha).
  issuerNif            String              @map("issuer_nif")
  invoiceNumber        String              @map("invoice_number")
  issueDate            DateTime            @map("issue_date") @db.Date
  /// TipoFactura (F1, R1…R4); null en las anulaciones.
  invoiceType          String?             @map("invoice_type")
  /// CuotaTotal e ImporteTotal exactos del registro de alta (el ImporteTotal también va en el QR); null en las
  /// anulaciones. Con ellos se recalcula la huella al comprobar la cadena.
  cuotaTotal           String?             @map("cuota_total")
  importeTotal         String?             @map("importe_total")
  previousHash         String?             @map("previous_hash") @db.Char(64)
  hash                 String              @db.Char(64)
  /// FechaHoraHusoGenRegistro: el texto exacto con el que se calculó la huella.
  generatedAt          String              @map("generated_at")
  /// XML del registro (RegistroAlta o RegistroAnulacion) tal como se generó: es lo que se remite y se conserva.
  xml                  String
  status               BillingRecordStatus @default(PENDING)
  /// Resultado de la remisión (únicas columnas modificables, por el worker).
  attempts             Int                 @default(0)
  submittedAt          DateTime?           @map("submitted_at") @db.Timestamptz(6)
  aeatCsv              String?             @map("aeat_csv")
  aeatErrorCode        String?             @map("aeat_error_code")
  aeatErrorDescription String?             @map("aeat_error_description")
  createdByUserId      String?             @map("created_by_user_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  taxpayer      Taxpayer      @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)
  billingSystem BillingSystem @relation(fields: [taxpayerId, billingSystemId], references: [taxpayerId, id], onDelete: Restrict)
  invoice       Invoice       @relation(fields: [taxpayerId, invoiceId], references: [taxpayerId, id], onDelete: Restrict)

  @@unique([billingSystemId, sequence])
  /// Un alta y, como mucho, una anulación por factura (las subsanaciones aún no se ofrecen).
  @@unique([invoiceId, kind])
  @@index([taxpayerId, createdAt])
  @@map("billing_records")
}

model InvoiceLine {
  id              String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  taxpayerId      String @map("taxpayer_id") @db.Uuid
  invoiceId       String @map("invoice_id") @db.Uuid
  position        Int
  description     String
  quantity        BigInt
  unitPrice       BigInt @map("unit_price")
  discountPercent Int    @map("discount_percent")
  taxKey          String @map("tax_key")
  /// Base de la línea en céntimos, calculada por fiscal-core (la BD nunca recalcula).
  lineBase        BigInt @map("line_base")

  taxpayer Taxpayer @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)
  invoice  Invoice  @relation(fields: [taxpayerId, invoiceId], references: [taxpayerId, id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@map("invoice_lines")
}

/// Certificado electrónico del contribuyente para remitir a la AEAT (Fase 6), cifrado por sobre: la clave que lo
/// descifra (CERTIFICATE_KEK) nunca está en la base de datos. Ver @facturalibre/aeat-client › certificates.
model TaxpayerCertificate {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  taxpayerId       String   @map("taxpayer_id") @db.Uuid
  sealed           String
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxpayer Taxpayer @relation(fields: [tenantId, taxpayerId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, taxpayerId])
  @@unique([taxpayerId])
  @@map("taxpayer_certificates")
}
